# Backend environment variables
# Copy this file to backend/.env for a local demo (pnpm demo:setup does this automatically).

NODE_ENV=development
PORT=3001

# Database
# Demo mode uses a local SQLite file. The path is relative to database/prisma/schema.prisma,
# so "file:./dev.db" resolves to database/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Auth
# Demo secret only — change this for real deployments. The app refuses to start if it is missing.
JWT_SECRET=dorm-demo-secret-change-me

# Frontend (used for CORS and the WebSocket gateway)
FRONTEND_URL=http://localhost:3000