{
  "name": "dorm-uapp",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --parallel -r run build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "lint": "pnpm --parallel -r run lint",
    "lint:backend": "pnpm --filter backend lint",
    "lint:frontend": "pnpm --filter frontend lint",
    "demo:setup": "node scripts/demo-setup.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "setup": "pnpm demo:setup",
    "db:generate": "pnpm --filter database prisma:generate",
    "db:migrate": "pnpm --filter database prisma:migrate",
    "db:deploy": "pnpm --filter database prisma:migrate:prod",
    "db:seed": "pnpm --filter database prisma:seed",
    "db:studio": "pnpm --filter database prisma:studio",
    "db:reset": "pnpm --filter database prisma:reset",
    "start": "pnpm --parallel -r run start",
    "start:backend": "pnpm --filter backend start:prod",
    "start:frontend": "pnpm --filter frontend start",
    "test": "pnpm --filter backend test:e2e",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}