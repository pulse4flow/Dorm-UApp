# Frontend environment variables (Next.js)
# Copy this file to frontend/.env.local if you need to override the defaults below.
# All variables are optional in demo mode — the app ships with sensible dev defaults.

# API base URL.
# Use "/api" to keep requests same-origin and let Next.js proxy /api/* to the backend
# (see next.config.ts). The proxy target defaults to http://127.0.0.1:3001.
NEXT_PUBLIC_API_URL=/api

# Socket.IO server URL used by live notifications.
NEXT_PUBLIC_SOCKET_IO_URL=http://localhost:3001